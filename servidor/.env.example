# Autor: Bruno Mareto
# Modelo do arquivo .env do servidor. Copie este arquivo para servidor/.env
# e preencha com os dados do seu MySQL. O .env não vai para o GitHub.

# Conexão com o MySQL (banco criado pelo script banco/Banco_PI_II.sql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_do_mysql
DB_NAME=pi2_demandas

# Chave que assina os tokens do login. Gere uma com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque_por_uma_chave_aleatoria